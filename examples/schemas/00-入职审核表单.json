              "startDate": "2015-07-01",
              "endDate": "2017-06-30"
            }
          ],
          "materials": {
            "idFront": "https://mock.example.com/materials/id-front.jpg",
            "idBack": "https://mock.example.com/materials/id-back.jpg",
            "degreeCertificate": "https://mock.example.com/materials/degree-certificate.jpg",
            "graduationCertificate": "https://mock.example.com/materials/graduation-certificate.jpg",
            "resume": "https://mock.example.com/materials/resume.pdf"
          },
          "reviewResult": "通过",
          "reviewComment": "基本信息、工作经历及相关材料已核验，符合入职条件。"
        }
      }
    }
  }
]
