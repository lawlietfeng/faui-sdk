            }
          ],
          "adjustmentRecords": [
            {
              "id": "adjustment-1",
              "remark": "补充客户招待费发票抬头说明",
              "date": "2026-08-27",
              "attachment": "https://placehold.co/1200x760/fef3c7/92400e.png?text=Adjustment+Attachment"
            },
            {
              "id": "adjustment-2",
              "remark": "补充项目出差审批截图",
              "date": "2026-08-28",
