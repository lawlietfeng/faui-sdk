            },
            {
              "id": "detail-2",
              "subject": "住宿费",
              "invoiceAmount": "¥4,500.00",
              "finalPayoutAfterTax": "¥4,252.50",
              "foreignExchangeRate": "不适用",
              "invoiceAttachment": "https://placehold.co/1200x760/fef3c7/92400e.png?text=Hotel+Invoice",
              "applicationAmount": "¥4,500.00",
