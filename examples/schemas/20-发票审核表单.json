            }
          ],
          "communicationRecords": [
            {
              "id": "communication-1",
              "approvalResult": "待调整",
              "approvalTime": "2026-08-27 09:20:00",
              "attachment": "https://placehold.co/1200x760/fce7f3/9d174d.png?text=Communication+Attachment",
