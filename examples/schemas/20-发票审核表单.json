              "finalPayoutAfterTax": "¥2,061.40",
              "foreignExchangeRate": "不适用",
              "invoiceAttachment": "https://placehold.co/1200x760/e2e8f0/334155.png?text=Traffic+Invoice",
              "applicationAmount": "¥2,180.00",
