            "flex": "0 0 130px",
            "fontSize": "18px",
            "fontWeight": 600,
            "color": "#9aa7b8"
          }
        },
        {
          "id": "contract-subject-value",
          "component": "typography",
          "content": "${$root.form.employment.contractSubject ?? '—'}",
          "ellipsis": {
            "tooltip": "${$root.form.employment.contractSubject ?? '—'}"
          },
          "style": {
            "flex": "1",
            "minWidth": 0,
            "fontSize": "18px",
            "color": "#253246"
          }
        },
        {
          "id": "contract-subject-copy-button",
          "component": "button",
          "type": "text",
          "shape": "circle",
          "size": "small",
          "style": {
            "minWidth": 24,
            "padding": 0,
            "color": "#94a3b8"
          },
          "on_tap": [
            {
              "action": "copy",
              "payload": {
                "text": "${$root.form.employment.contractSubject}"
              }
            },
            {
              "action": "message",
              "payload": {
                "type": "success",
                "content": "复制成功",
                "duration": 2
              }
            }
          ],
          "children": [
            "contract-subject-copy-icon"
          ]
        },
        {
          "id": "contract-subject-copy-icon",
          "component": "icon",
          "icon": "CopyOutlined",
          "style": {
            "fontSize": "17px"
          }
        },
        {
          "id": "contract-type-col",
          "component": "col",
          "span": 8,
          "xs": 24,
          "md": 12,
          "xl": 8,
          "visible": "${$root.ui.fieldVisible.contractType}",
          "style": {
            "padding": "20px 16px",
            "borderBottom": "1px solid #edf1f5"
          },
          "children": [
            "contract-type-field"
          ]
        },
        {
          "id": "contract-type-field",
          "component": "flex",
          "align": "center",
          "gap": 10,
          "children": [
            "contract-type-label",
            "contract-type-value"
          ]
        },
        {
          "id": "contract-type-label",
          "component": "typography",
          "content": "合同类型",
          "style": {
            "flex": "0 0 130px",
            "fontSize": "18px",
            "fontWeight": 600,
            "color": "#9aa7b8"
          }
        },
        {
          "id": "contract-type-value",
          "component": "typography",
          "content": "${$root.form.employment.contractType ?? '—'}",
          "ellipsis": {
            "tooltip": "${$root.form.employment.contractType ?? '—'}"
          },
          "style": {
            "flex": "1",
            "minWidth": 0,
            "fontSize": "18px",
            "color": "#253246"
          }
        }
      ]
    }
  }
